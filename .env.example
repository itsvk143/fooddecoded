# ==============================================================================
# FoodDecode Environment Variables
# Configure these in your Vercel Project Settings or local .env.local
# DO NOT commit real secrets to GitHub!
# ==============================================================================

# MongoDB Atlas Connection String
# Obtain from MongoDB Atlas -> Database -> Connect -> Drivers -> Node.js
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Target Database Name in MongoDB
MONGODB_DB_NAME=fooddecode

# Admin API Secret Key (Used for protecting admin operations and headers)
ADMIN_SECRET_KEY=replace_with_a_secure_random_string_min_32_chars

# Application Base URL (used for OAuth callback resolution and metadata; NO trailing slash)
# Local dev: http://localhost:3000 | Vercel Production: https://fooddecoded.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Open Food Facts API User-Agent (recommended for ethical API access)
OPEN_FOOD_FACTS_USER_AGENT=FoodDecode-Platform/1.0 (https://github.com/your-username/fooddecode)

# Google OAuth 2.0 Credentials (Obtain from Google Cloud Console -> APIs & Services -> Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# Admin Role Allowlists (comma-separated emails; base admins are also allowlisted server-side)
ADMIN_EMAILS=fooddecoded01@gmail.com,itsvikash143@gmail.com
SUPER_ADMIN_EMAILS=
