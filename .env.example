# ==============================================================================
# FoodDecode Environment Variables
# Configure these in your Vercel Project Settings or local .env.local
# DO NOT commit real secrets to GitHub!
# ==============================================================================

# MongoDB Atlas Connection String
# Obtain from MongoDB Atlas -> Database -> Connect -> Drivers -> Node.js
# Example: mongodb+srv://dbUser:yourPassword@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://trijalad_db_user:rIB6OCdPaausIYly@fooddecoded.la2rb4z.mongodb.net/

# Target Database Name in MongoDB
MONGODB_DB_NAME=fooddecode

# Admin API Secret Key (Used for protecting admin operations and headers)
ADMIN_SECRET_KEY=replace_with_a_secure_random_string_min_32_chars

# Application Base URL (used for metadata and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Open Food Facts API User-Agent (recommended for ethical API access)
OPEN_FOOD_FACTS_USER_AGENT=FoodDecode-Platform/1.0 (https://github.com/your-username/fooddecode)
